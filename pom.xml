<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ============================================================
         官方 parent：一行顶替原来手写的 dependencyManagement + 编译插件
         parent 会自动管好：依赖版本、编译插件、编码、测试插件、打包插件
         ============================================================ -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.wang</groupId>
    <artifactId>imau-springboot-crud</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>imau-springboot-crud</name>
    <description>Spring Boot 3 + MyBatis-Plus 增删改查示范项目（含分页、校验、统一返回、全局异常）</description>

    <properties>
        <java.version>17</java.version>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <!--
          重要：Boot 3.5 的 BOM 会把 MySQL 驱动升到 9.x，而 9.x 官方支持矩阵不含 MySQL 5.7。
          本项目连接的是 MySQL 5.7，所以必须显式钉住 8.0.32。
        -->
        <mysql.version>8.0.32</mysql.version>
    </properties>

    <dependencies>
        <!-- Web：自带 Tomcat + Spring MVC + Jackson（JSON 序列化，不需要额外引入 fastjson） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验：@NotBlank / @Size / @Valid 全靠它（Spring Boot 3 用 jakarta.validation 包） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MyBatis-Plus：Spring Initializr 的依赖列表里没有它，必须手写；注意是 spring-boot3-starter -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- MySQL 驱动：只在运行时需要，所以 scope=runtime -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok：用注解生成 getter/setter/构造方法，减少样板代码 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试：JUnit 5 + Spring Test + AssertJ + Mockito -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Lombok 只是编译期工具，不该打进最终 jar -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
